{
  "expo": {
    "name": "Pet Interactive Tool",
    "slug": "pet-interactive-tool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petinteractivetool.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos of your pet for mood detection.",
        "NSPhotoLibraryUsageDescription": "Used to select pet photos from your library.",
        "NSMicrophoneUsageDescription": "Used for interactive pet audio features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF5F0"
      },
      "package": "com.petinteractivetool.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pet Interactive Tool to access your camera to take photos of your pet."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pet Interactive Tool to access your photos to analyze your pet's mood."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
